{
  "name": "linger",
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "description": "Multi-account Steam hour booster built on steam-user",
  "type": "module",
  "author": "vocal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vocaldll/Linger.git"
  },
  "bin": {
    "linger": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/src/cli.js run",
    "manage": "node dist/src/cli.js manage",
    "test": "pnpm run build && node --test --enable-source-maps dist/**/*.test.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "qrcode-terminal": "^0.12.0",
    "steam-session": "^1.9.4",
    "steam-user": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/steam-user": "^5.1.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
